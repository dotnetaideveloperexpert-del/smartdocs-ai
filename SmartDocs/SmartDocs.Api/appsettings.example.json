{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=YOUR-SERVER\\SQLEXPRESS;Initial Catalog=SmartDocsDb;Integrated Security=True;Encrypt=True;Trust Server Certificate=True"
  },
  "Jwt": {
    "Key": "REPLACE-WITH-32-PLUS-CHARACTER-SECRET",
    "Issuer": "SmartDocs",
    "Audience": "SmartDocsUsers"
  },
  "AzureOpenAI": {
    "Endpoint": "https://YOUR-RESOURCE.openai.azure.com/",
    "Key": "YOUR-AZURE-OPENAI-KEY"
  },
  "AzureSearch": {
    "Endpoint": "https://YOUR-SEARCH.search.windows.net",
    "Key": "YOUR-SEARCH-KEY"
  },
  "AzureBlob": {
    "ConnectionString": "",
    "Container": "uploads"
  }
}